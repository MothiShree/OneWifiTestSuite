[Unit]
Description=Install rdkfmac Driver
After=wifi.service

[Service]
Type=forking
RemainAfterExit=yes

ExecStartPre=/bin/sh -c '\
    if systemctl cat wifi.service >/dev/null 2>&1; then \
        while ! systemctl is-active --quiet wifi.service; do \
            sleep 5; \
        done; \
    fi'

TimeoutStartSec=0
ExecStart=/usr/bin/rdkfmac_modprobe.sh start
ExecStop=/usr/bin/rdkfmac_modprobe.sh stop
Restart=always

[Install]
WantedBy=wifi-initialized.target
